# Python
__pycache__/
*.py[cod]
*.so
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# R / renv local state
.Rhistory
.RData
.Ruserdata
renv/library/
renv/staging/

# Editors and operating systems
.DS_Store
.vscode/
.idea/
*.swp

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Data: retain only documentation and tracked metadata
/data/raw/*
!/data/raw/README.md
/data/external/*
!/data/external/README.md
/data/interim/*
!/data/interim/README.md
/data/processed/*
!/data/processed/README.md

# Generated outputs: retain placeholders only
/results/figures/*
!/results/figures/.gitkeep
/results/tables/*
!/results/tables/.gitkeep
/results/models/*
!/results/models/.gitkeep
/results/logs/*
!/results/logs/.gitkeep

# Manuscript build artefacts
/manuscript/figures/*
!/manuscript/figures/.gitkeep
/manuscript/tables/*
!/manuscript/tables/.gitkeep
